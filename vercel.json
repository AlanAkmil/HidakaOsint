{
    "version": 2,
    "builds": [
        { "src": "index.html", "use": "@vercel/static" },
        { "src": "api/*.js", "use": "@vercel/node" }
    ],
    "routes": [
        { "src": "/", "dest": "/index.html" },
        { "src": "/api/(.*)", "dest": "/api/$1" },
        { "src": "/(.*.css)", "dest": "/$1" },
        { "src": "/(.*.js)", "dest": "/$1" }
    ]
}